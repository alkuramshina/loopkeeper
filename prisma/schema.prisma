generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId                     String               @id @default(uuid())
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  email                      String               @unique
  passwordHash               String
  name                       String?
  avatarUrl                  String?
  applicationRole            ApplicationRole      @default(USER)
  isDeleted                  Boolean              @default(false)
  ownedCampaigns             Campaign[]           @relation("GameMaster")
  campaignMemberships        CampaignMember[]     @relation("CampaignMemberships")
  characters                 Character[]
  authSessions               AuthSession[]
  createdCampaignInvitations CampaignInvitation[] @relation("CampaignInvitationCreator")
  notes                      Note[]

  @@map("users")
}

model AuthSession {
  sessionId        String    @id @default(uuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  user             User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId           String

  @@index([userId])
  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model Campaign {
  campaignId  String               @id @default(uuid())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  title       String
  system      System?
  description String?
  coverUrl    String?
  owner       User                 @relation("GameMaster", fields: [ownerId], references: [userId])
  ownerId     String
  gameSystem  GameSystem?          @relation(fields: [system], references: [slug])
  characters  Character[]
  members     CampaignMember[]     @relation("CampaignMembers")
  invitations CampaignInvitation[]
  notes       Note[]

  @@index([ownerId])
  @@map("campaigns")
}

model CampaignMember {
  memberId     String       @id @default(uuid())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation("CampaignMemberships", fields: [userId], references: [userId])
  userId       String
  campaign     Campaign     @relation("CampaignMembers", fields: [campaignId], references: [campaignId])
  campaignId   String
  campaignRole CampaignRole @default(PLAYER)

  @@unique([userId, campaignId])
  @@map("campaign_members")
}

model CampaignInvitation {
  invitationId String       @id @default(uuid())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tokenHash    String
  role         CampaignRole
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  campaign     Campaign     @relation(fields: [campaignId], references: [campaignId], onDelete: Cascade)
  campaignId   String
  createdBy    User         @relation("CampaignInvitationCreator", fields: [createdById], references: [userId])
  createdById  String

  @@index([campaignId])
  @@index([expiresAt])
  @@map("campaign_invitations")
}

model Note {
  noteId     String         @id @default(uuid())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  title      String
  content    String
  visibility NoteVisibility @default(PRIVATE)
  campaign   Campaign       @relation(fields: [campaignId], references: [campaignId])
  campaignId String
  author     User           @relation(fields: [authorId], references: [userId])
  authorId   String

  @@index([campaignId, visibility])
  @@index([campaignId, authorId])
  @@map("notes")
}

model GameSystem {
  slug        System              @id
  name        String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  campaigns   Campaign[]
  templates   CharacterTemplate[]

  @@map("game_systems")
}

model CharacterTemplate {
  templateId String      @id @default(uuid())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  name       String
  schema     Json
  version    Int         @default(1)
  isActive   Boolean     @default(true)
  system     GameSystem  @relation(fields: [systemSlug], references: [slug])
  systemSlug System
  characters Character[]

  @@unique([systemSlug, name, version])
  @@index([systemSlug, isActive])
  @@map("character_templates")
}

model Character {
  characterId String            @id @default(uuid())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  name        String
  description String?
  avatarUrl   String?
  data        Json              @default("{}")
  isNPC       Boolean           @default(false)
  isActive    Boolean           @default(true)
  campaign    Campaign          @relation(fields: [campaignId], references: [campaignId])
  campaignId  String
  owner       User              @relation(fields: [ownerId], references: [userId])
  ownerId     String
  template    CharacterTemplate @relation(fields: [templateId], references: [templateId])
  templateId  String

  @@index([campaignId])
  @@index([ownerId])
  @@map("characters")
}

enum CampaignRole {
  PLAYER
  VIEWER
}

enum NoteVisibility {
  PRIVATE
  MASTER_ONLY
  PLAYERS
  PUBLIC
}

enum ApplicationRole {
  USER
  ADMIN
}

enum System {
  TALES_FROM_THE_LOOP
}
