generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId                     String               @id @default(uuid())
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  email                      String               @unique
  passwordHash               String
  name                       String?
  avatarUrl                  String?
  avatarAsset                MediaAsset?          @relation("UserAvatar", fields: [avatarAssetId], references: [assetId], onDelete: SetNull)
  avatarAssetId              String?              @unique
  applicationRole            ApplicationRole      @default(USER)
  isDeleted                  Boolean              @default(false)
  ownedCampaigns             Campaign[]           @relation("GameMaster")
  campaignMemberships        CampaignMember[]     @relation("CampaignMemberships")
  characters                 Character[]
  authSessions               AuthSession[]
  createdCampaignInvitations CampaignInvitation[] @relation("CampaignInvitationCreator")

  createdElements CampaignElement[]

  investigationCards InvestigationCard[] @relation("InvestigationCardCreator")
  investigationLinks InvestigationLink[] @relation("InvestigationLinkCreator")

  @@map("users")
}

model MediaAsset {
  assetId              String                @id @default(uuid())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  storageKey           String                @unique
  contentType          MediaAssetContentType @default(IMAGE_WEBP)
  purpose              MediaAssetPurpose
  byteSize             Int
  width                Int
  height               Int
  avatarOwner          User?                 @relation("UserAvatar")
  characterAvatar      Character?            @relation("CharacterAvatar")
  campaignCover        Campaign?             @relation("CampaignCover")
  backgroundCampaign   Campaign?             @relation("CampaignBackgroundAssets", fields: [backgroundCampaignId], references: [campaignId], onDelete: Cascade)
  backgroundCampaignId String?

  @@index([backgroundCampaignId])
  @@index([purpose])
  @@map("media_assets")
}

model AuthSession {
  sessionId        String    @id @default(uuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  user             User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId           String

  @@index([userId])
  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model Campaign {
  campaignId   String               @id @default(uuid())
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  title        String
  system       System?
  description  String?
  coverUrl     String?
  coverAsset   MediaAsset?          @relation("CampaignCover", fields: [coverAssetId], references: [assetId], onDelete: SetNull)
  coverAssetId String?              @unique
  owner        User                 @relation("GameMaster", fields: [ownerId], references: [userId])
  ownerId      String
  gameSystem   GameSystem?          @relation(fields: [system], references: [slug])
  characters   Character[]
  members      CampaignMember[]     @relation("CampaignMembers")
  invitations  CampaignInvitation[]

  elements                CampaignElement[]
  backgrounds             Json                            @default("[]")
  backgroundAssets        MediaAsset[]                    @relation("CampaignBackgroundAssets")
  backgroundSelectionMode CampaignBackgroundSelectionMode @default(FIXED)
  fixedBackgroundId       String?

  investigationBoard InvestigationBoard?
  investigationCards InvestigationCard[]
  investigationLinks InvestigationLink[]

  @@index([ownerId])
  @@map("campaigns")
}

model CampaignMember {
  memberId     String       @id @default(uuid())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation("CampaignMemberships", fields: [userId], references: [userId])
  userId       String
  campaign     Campaign     @relation("CampaignMembers", fields: [campaignId], references: [campaignId])
  campaignId   String
  campaignRole CampaignRole @default(PLAYER)

  @@unique([userId, campaignId])
  @@map("campaign_members")
}

model CampaignInvitation {
  invitationId String       @id @default(uuid())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tokenHash    String
  role         CampaignRole
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  campaign     Campaign     @relation(fields: [campaignId], references: [campaignId], onDelete: Cascade)
  campaignId   String
  createdBy    User         @relation("CampaignInvitationCreator", fields: [createdById], references: [userId])
  createdById  String

  @@index([campaignId])
  @@index([expiresAt])
  @@map("campaign_invitations")
}

model CampaignElement {
  elementId          String                @id @default(uuid())
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  campaign           Campaign              @relation(fields: [campaignId], references: [campaignId], onDelete: Cascade)
  campaignId         String
  createdBy          User                  @relation(fields: [createdById], references: [userId])
  createdById        String
  type               CampaignElementType
  title              String
  content            String?
  access             CampaignElementAccess @default(MASTER_ONLY)
  typeData           Json                  @default("{}")
  sortOrder          Int                   @default(0)
  imageUrl           String?
  coverAssetId       String?               @unique
  mapAssetId         String?               @unique
  investigationCards InvestigationCard[]   @relation("InvestigationCardElement")

  @@index([campaignId, type, access])
  @@map("campaign_elements")
}

model InvestigationBoard {
  boardId    String              @id @default(uuid())
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  campaign   Campaign            @relation(fields: [campaignId], references: [campaignId])
  campaignId String              @unique
  cards      InvestigationCard[]
  links      InvestigationLink[]

  @@map("investigation_boards")
}

model InvestigationCard {
  cardId    String                @id @default(uuid())
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  cardKind  InvestigationCardKind @default(FREE)
  title     String?
  content   String?
  tags      String[]
  color     String?
  icon      String?

  element     CampaignElement?        @relation("InvestigationCardElement", fields: [elementId], references: [elementId], onDelete: Cascade)
  elementId   String?
  character   Character?              @relation("InvestigationCardCharacter", fields: [characterId], references: [characterId], onDelete: Cascade)
  characterId String?
  board       InvestigationBoard      @relation(fields: [boardId], references: [boardId], onDelete: Cascade)
  boardId     String
  campaign    Campaign                @relation(fields: [campaignId], references: [campaignId])
  campaignId  String
  createdBy   User                    @relation("InvestigationCardCreator", fields: [createdById], references: [userId])
  createdById String
  node        InvestigationBoardNode?
  linksFrom   InvestigationLink[]     @relation("InvestigationLinkFrom")
  linksTo     InvestigationLink[]     @relation("InvestigationLinkTo")

  @@index([campaignId])
  @@index([elementId])
  @@index([characterId])
  @@map("investigation_cards")
}

model InvestigationLink {
  linkId      String             @id @default(uuid())
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  label       String?
  board       InvestigationBoard @relation(fields: [boardId], references: [boardId], onDelete: Cascade)
  boardId     String
  campaign    Campaign           @relation(fields: [campaignId], references: [campaignId])
  campaignId  String
  fromCard    InvestigationCard  @relation("InvestigationLinkFrom", fields: [fromCardId], references: [cardId], onDelete: Cascade)
  fromCardId  String
  toCard      InvestigationCard  @relation("InvestigationLinkTo", fields: [toCardId], references: [cardId], onDelete: Cascade)
  toCardId    String
  createdBy   User               @relation("InvestigationLinkCreator", fields: [createdById], references: [userId])
  createdById String

  @@unique([campaignId, fromCardId, toCardId])
  @@map("investigation_links")
}

model InvestigationBoardNode {
  nodeId    String            @id @default(uuid())
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  x         Float             @default(0)
  y         Float             @default(0)
  width     Float             @default(240)
  height    Float             @default(160)
  card      InvestigationCard @relation(fields: [cardId], references: [cardId], onDelete: Cascade)
  cardId    String            @unique

  @@map("investigation_board_nodes")
}

model GameSystem {
  slug        System              @id
  name        String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  campaigns   Campaign[]
  templates   CharacterTemplate[]

  @@map("game_systems")
}

model CharacterTemplate {
  templateId String   @id @default(uuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  name       String
  schema     Json
  version    Int      @default(1)

  isActive   Boolean     @default(true)
  system     GameSystem  @relation(fields: [systemSlug], references: [slug])
  systemSlug System
  characters Character[]

  @@unique([systemSlug, name, version])
  @@index([systemSlug, isActive])
  @@map("character_templates")
}

model Character {
  characterId   String      @id @default(uuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  name          String
  description   String?
  avatarUrl     String?
  avatarAsset   MediaAsset? @relation("CharacterAvatar", fields: [avatarAssetId], references: [assetId], onDelete: SetNull)
  avatarAssetId String?     @unique
  data          Json        @default("{}")

  isActive           Boolean             @default(true)
  campaign           Campaign            @relation(fields: [campaignId], references: [campaignId])
  campaignId         String
  owner              User                @relation(fields: [ownerId], references: [userId])
  ownerId            String
  template           CharacterTemplate   @relation(fields: [templateId], references: [templateId])
  templateId         String
  investigationCards InvestigationCard[] @relation("InvestigationCardCharacter")

  @@index([campaignId])
  @@index([ownerId])
  @@map("characters")
}

enum MediaAssetContentType {
  IMAGE_WEBP
}

enum MediaAssetPurpose {
  AVATAR
  CHARACTER_AVATAR
  CAMPAIGN_COVER
  CAMPAIGN_BACKGROUND
}

enum CampaignBackgroundSelectionMode {
  FIXED
  RANDOM
}

enum InvestigationCardKind {
  FREE

  ELEMENT_REFERENCE
  CHARACTER_REFERENCE
}

enum CampaignRole {
  PLAYER
  VIEWER
}

enum CampaignElementType {
  NOTE
  LOCATION
  NPC
  OTHER
}

enum CampaignElementAccess {
  PRIVATE
  MASTER_ONLY
  SHARED
}

enum ApplicationRole {
  USER
  ADMIN
}

enum System {
  TALES_FROM_THE_LOOP
}
