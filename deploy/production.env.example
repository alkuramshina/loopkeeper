# Copy outside the checkout; chmod 600. No real credentials in this file.
# Images come from manifest.env; do not replace digest references with latest.
DOMAIN=
TLS_EMAIL=
POSTGRES_USER=loopkeeper
POSTGRES_DB=loopkeeper
# Generate each password/secret separately: openssl rand -hex 32
# Use URL-safe passwords because DATABASE_URL is assembled by Compose.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=loopkeeper-root
MINIO_ROOT_PASSWORD=
S3_BUCKET=loopkeeper-production
S3_ACCESS_KEY_ID=loopkeeper-runtime
S3_SECRET_ACCESS_KEY=
JWT_SECRET=
REFRESH_JWT_SECRET=
# Preserve this value on updates to keep active invitation links valid.
INVITATION_SECRET=
