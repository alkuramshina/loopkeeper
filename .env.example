# Environment: development, test, production
NODE_ENV=development
TRUST_PROXY_HOPS=0

# Application port
PORT=3000

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# Database connection URL
DATABASE_URL=postgresql://loopkeeper:loopkeeper@localhost:5433/loopkeeper

# Global in-memory request limit
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Per-minute limit for register/login/refresh/change-password.
# Only automated browser tests raise it; production allows at most 5.
AUTH_THROTTLE_LIMIT=5

# JWT secrets must be unique, random values of at least 20 characters.
# For example: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Refresh JWT uses a separate secret.
REFRESH_JWT_SECRET=
REFRESH_JWT_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# Signs invitation links, so an active link can be shown to the master again.
# Another unique random value of at least 20 characters; changing it
# invalidates every active invitation link.
INVITATION_SECRET=

# Used only by the explicit local seed command.
# The seed is disabled until this value is explicitly set to true.
SEED_ADMIN=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Private development MinIO. Root credentials are for provisioning only.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=loopkeeper
S3_ACCESS_KEY_ID=loopkeeper-app
S3_SECRET_ACCESS_KEY=loopkeeper-app-dev-secret
S3_FORCE_PATH_STYLE=true
S3_KEY_PREFIX=
MINIO_ROOT_PASSWORD=loopkeeper-root-dev-secret
MINIO_APP_PASSWORD=loopkeeper-app-dev-secret
