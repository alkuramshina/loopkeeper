# Environment: development, test, production
NODE_ENV=development

# Application port
PORT=3000

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# Database connection URL
DATABASE_URL=postgresql://loopkeeper:loopkeeper@localhost:5432/loopkeeper

# JWT secrets must be unique, random values of at least 20 characters.
# For example: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Refresh JWT uses a separate secret.
REFRESH_JWT_SECRET=
REFRESH_JWT_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# Used only by the explicit local seed command.
ADMIN_EMAIL=
ADMIN_PASSWORD=
